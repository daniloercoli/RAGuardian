# RAGuardian local environment
# Copy this file to .env for a single-machine development run:
#   cp .env.example .env
#
# This file is safe to copy for local testing. Replace the dev secrets and add
# provider keys before using the app beyond your own machine.

# ---------------------------------------------------------------------------
# 5-minute local defaults
# ---------------------------------------------------------------------------

# Dev-only secrets. Use long random values for shared or production instances.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=dev-only-change-me-min-32-characters
RAG_SECRET_KEY=dev-only-change-me-too-min-32-characters

# No Redis is required for local development.
RAG_STATE_BACKEND=memory
RAG_QUEUE_BACKEND=inline

# Local persistent vector index.
VECTOR_STORE_BACKEND=chroma_persistent
CHROMA_PERSIST_DIR=app/chroma_db

# Local embeddings are the built-in default. Select a different embedding
# provider or model from Admin -> AI Settings; the choice is stored in settings.

# Local bootstrap login:
#   email: admin@example.local (or leave the email field empty)
#   password: admin
#
# For any shared instance, uncomment one of these and set a real password.
# Preferred: a Werkzeug password hash.
# Generate with:
# python -c "from werkzeug.security import generate_password_hash; import getpass; print(generate_password_hash(getpass.getpass()))"
# RAG_ADMIN_PASSWORD_HASH=
# Dev/plaintext fallback only:
# RAG_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Provider keys
# ---------------------------------------------------------------------------
# The UI starts without provider keys. To ask real questions, configure at least
# one LLM provider in Admin -> Configuration, or uncomment one hosted key here.

# REGOLO_API_KEY=
# MISTRAL_API_KEY=

# Optional legacy/global API key for /api/v1/* clients. Prefer per-user
# workspace API keys from Admin -> API Keys.
# RAG_API_KEY=

# ---------------------------------------------------------------------------
# Local runtime knobs
# ---------------------------------------------------------------------------

# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# FLASK_DEBUG=0
# MAX_UPLOAD_SIZE_MB=10
# MAX_AUDIO_UPLOAD_SIZE_MB=50
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW=60
# RAG_REQUEST_TIMEOUT_SECONDS=0
# RAG_CORS_ALLOWED_ORIGINS=
# RAG_CORS_ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
# RAG_CORS_ALLOWED_HEADERS=Content-Type,X-API-Key,X-Request-ID
# RAG_CORS_ALLOW_CREDENTIALS=0
# RAG_CORS_MAX_AGE=600

# LOG_DIR=app/logs
# LOG_FILE=rag_service.log
# ENABLE_FILE_LOG=1
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# LOG_TO_CONSOLE=1
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=10
# LLM_DEBUG_LOG=false
# METRICS_ENABLED=1

# Runtime data paths. Defaults are gitignored.
# UPLOAD_FOLDER=app/uploads
# RAG_DATA_DIR=app/data
# RAG_SETTINGS_FILE=app/data/settings.json
# RAG_FILE_INDEX=app/data/files.json
# RAG_USERS_DB=app/data/users.db
# RAG_SECRETS_FILE=app/data/secrets.json
# RAG_WORKSPACE_DATA_DIR=app/data/workspaces
# RAG_WORKSPACE_UPLOAD_DIR=app/uploads/workspaces
# RAG_DEFAULT_PROVIDERS_FILE=app/default_providers.json
# Maximum number of additional knowledge bases per workspace (the default
# knowledge base does not count toward this limit).
# RAG_MAX_KNOWLEDGE_BASES=20
# Maximum number of knowledge bases that one query may search together.
# Set to 1 to disable multi-KB querying operationally.
# RAG_MAX_QUERY_KNOWLEDGE_BASES=5

# ---------------------------------------------------------------------------
# Conversation history (persistent per-workspace transcript)
# ---------------------------------------------------------------------------
# When enabled, completed turns are persisted to a per-workspace SQLite
# database so they survive restarts and TTL expiry of the warm memory.
# RAG_CONVERSATION_HISTORY_ENABLED=0
# RAG_MAX_CONVERSATIONS_PER_WORKSPACE=200
# RAG_CONVERSATION_HISTORY_RETENTION_DAYS=90
# RAG_MAX_CONVERSATION_HISTORY_MESSAGE_CHARS=50000
# RAG_MAX_CONVERSATION_MESSAGES=2000
# RAG_MAX_CONVERSATION_BYTES=33554432
# RAG_MAX_CONVERSATION_SOURCES_BYTES_PER_TURN=262144
# RAG_MAX_CONVERSATION_METADATA_BYTES_PER_TURN=65536
# RAG_MAX_CONVERSATION_HISTORY_BYTES=268435456
# RAG_MAX_PENDING_HISTORY_TURNS_PER_WORKSPACE=100
# RAG_CONVERSATION_TURN_LEASE_SECONDS=900
# RAG_PENDING_TURN_RESULT_TTL_SECONDS=21600
# RAG_PENDING_TURN_RESULT_MAX_PAYLOAD_BYTES=2097152
# RAG_PENDING_TURN_RESULT_MAX_TOTAL_BYTES=67108864
# RAG_INCOMPLETE_HISTORY_TURN_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Production-only examples
# ---------------------------------------------------------------------------

# Gunicorn:
# GUNICORN_HOST=127.0.0.1
# RAG_ENV=production
# GUNICORN_PORT=5000
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=180
# GUNICORN_RUNTIME_LOG=gunicorn_runtime.log
# GUNICORN_ACCESS_LOG=gunicorn_access.log

# Redis-backed multi-worker/runtime queue mode:
# REDIS_URL=redis://localhost:6379/0
# RAG_STATE_BACKEND=redis
# RAG_QUEUE_BACKEND=redis
# A Redis queue requires the Redis state backend for destructive KB jobs.
# RAG_STATE_PREFIX=rag
# RAG_QUEUE_NAME=rag-default
# RAG_JOB_TTL_SECONDS=86400
# RAG_LOCK_TTL_SECONDS=21600
# REDIS_CONNECT_TIMEOUT=1.0
# REDIS_SOCKET_TIMEOUT=1.0
# REDIS_MAX_CONNECTIONS=20

# Retrieval, generation, embeddings, cache, and internal-knowledge settings are
# managed from Admin -> AI Settings and persisted in RAG_SETTINGS_FILE.

# Optional backups. Disabled unless explicitly enabled.
# BACKUP_ENABLED=0
# BACKUP_DIR=app/backups
# BACKUP_SCHEDULE_HOURS=2,20
# BACKUP_RETENTION_DAYS=7
# Encrypt the complete snapshot (Chroma, users, secrets, workspaces and uploads).
# BACKUP_ENCRYPTION_KEY=

# Optional corporate CA bundle.
# CA_CERT_PATH=

# ---------------------------------------------------------------------------
# Code Interpreter (analisi dati con Python nella chat)
# ---------------------------------------------------------------------------
# Abilita code interpreter. I file caricati qui NON vengono indicizzati per RAG.
# CODE_INTERPRETER_ENABLED=1
# Build the Docker image automatically on first use when it is missing.
# CODE_INTERPRETER_AUTO_BUILD=1
# Timeout esecuzione codice Python (secondi)
# CODE_INTERPRETER_TIMEOUT=60
# Dimensione max file per code interpreter (MB)
# CODE_INTERPRETER_MAX_FILE_MB=25
# TTL dei file scratch dopo ultima modifica (ore)
# CODE_INTERPRETER_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Code Interpreter Docker settings
# ---------------------------------------------------------------------------
# CODE_INTERPRETER_DOCKER_MEMORY=512m
# CODE_INTERPRETER_DOCKER_CPU_QUOTA=100000
# CODE_INTERPRETER_TIMEOUT=120
